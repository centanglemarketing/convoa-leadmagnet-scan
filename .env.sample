# Next.js Application Settings
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_STRATEGY_CALL_URL=https://convoa.com

# Google Places API configuration
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Resend Email Service configuration
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=Convoa Scan <scan@send.convoa.com>

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=convoa_user
POSTGRES_PASSWORD=convoa_password
POSTGRES_DB=convoa_db

# Connection URL for postgres (Node-Postgres)
DATABASE_URL=postgresql://convoa_user:convoa_password@localhost:5432/convoa_db
